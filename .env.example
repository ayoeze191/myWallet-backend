# Copy to .env and fill in. The server exits on boot if JWT_SECRET is unset.
PORT=4000

# Matches docker-compose.yml. Point elsewhere for your own Postgres.
DATABASE_URL=postgresql://ourwallet_user:ourwallet_password@localhost:5432/ourwallet

# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# From dashboard.paystack.com — a test key (sk_test_...) is fine.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Origin used for the Paystack callback URL (a backend route) and for
# invite links (a frontend route) — see the README note about this.
APP_BASE_URL=http://localhost:4000

# Ajo sweep interval in ms. Lower it while demoing.
AJO_TICK_MS=60000
