# Copy to .env and fill in. The server exits on boot if JWT_SECRET is unset.
PORT=4000

# Matches docker-compose.yml. Point elsewhere for your own Postgres.
DATABASE_URL=postgresql://ourwallet_user:ourwallet_password@localhost:5432/ourwallet

# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# From dashboard.paystack.com — a test key (sk_test_...) is fine.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Set to "production" on your host. The server then refuses to boot if
# APP_BASE_URL or FRONTEND_BASE_URL is unset or still points at localhost.
# NODE_ENV=production

# This backend's own origin. Only used to build the Paystack callback URL,
# which Paystack redirects the browser to after payment.
APP_BASE_URL=http://localhost:4000

# The FRONTEND's origin. Invite links point here, because /join/:code is a
# React Router route, not a backend one. In production this is your Netlify
# site — pointing it at the backend produces dead invite links.
FRONTEND_BASE_URL=http://localhost:5173

# Ajo sweep interval in ms. Lower it while demoing.
AJO_TICK_MS=60000
